Да. Ниже дам полный GeoSchemeDocs.cmake, а места, которые я изменил или добавил, помечу комментариями # [ИЗМЕНЕНО] / # [ДОБАВЛЕНО], чтобы можно было быстро сравнить с твоей текущей версией.
Основные исправления: убрал логику «если папка HTML уже существует — вообще не создавать custom_command», исправил сбор include-путей, убрал жёсткую привязку к MinGW 7.3.0, сделал поиск qdoc устойчивее, добавил include-пути проекта для общего индекса и сделал rebuild-цели реально рабочими.
# ============================================================================
# GeoSchemeDocs.cmake
#
# Централизованная система сборки документации QDoc для GeoScheme.
#
# Возможности:
#   - поиск QDoc из установленного Qt;
#   - подготовка окружения Qt + MinGW;
#   - сбор include-путей из target и его зависимостей;
#   - отдельная документация для каждого модуля;
#   - общий индекс GeoScheme;
#   - stamp-файлы как механизм кэширования;
#   - отдельные rebuild-цели;
#   - полная пересборка документации.
# ============================================================================


# ============================================================================
# Настройки
# ============================================================================

# [ДОБАВЛЕНО]
# Версия стандарта C++, с которой QDoc должен разбирать исходники.
# При необходимости можно изменить при конфигурации:
#
#   -DGEOSCHEME_QDOC_CXX_STANDARD=17
#
set(
    GEOSCHEME_QDOC_CXX_STANDARD
    "14"
    CACHE STRING
    "C++ standard used by QDoc"
)


# ============================================================================
# Поиск QDoc
# ============================================================================

function(_gs_find_qdoc)

    find_package(Qt5 REQUIRED COMPONENTS Core)

    # [ИЗМЕНЕНО]
    # Раньше использовался LOCATION у Qt5::Core.
    #
    # LOCATION для imported target является хрупким решением и зависит
    # от версии CMake/Qt.
    #
    # Qt5Core_DIR надёжнее позволяет определить корень установленного Qt.

    if (NOT Qt5Core_DIR)
        message(
            FATAL_ERROR
            "Qt5Core_DIR is not defined. Cannot determine Qt installation."
        )
    endif()

    get_filename_component(
        _gs_qt_cmake_dir
        "${Qt5Core_DIR}"
        DIRECTORY
    )

    get_filename_component(
        _gs_qt_lib_dir
        "${_gs_qt_cmake_dir}"
        DIRECTORY
    )

    get_filename_component(
        _gs_qt_root
        "${_gs_qt_lib_dir}"
        DIRECTORY
    )

    # [ИЗМЕНЕНО]
    # Если QDOC_EXECUTABLE уже был задан, но файл больше не существует,
    # путь пересчитывается.

    if (
        NOT QDOC_EXECUTABLE
        OR NOT EXISTS "${QDOC_EXECUTABLE}"
    )

        if (WIN32)
            set(
                _gs_qdoc_candidate
                "${_gs_qt_root}/bin/qdoc.exe"
            )
        else()
            set(
                _gs_qdoc_candidate
                "${_gs_qt_root}/bin/qdoc"
            )
        endif()

        if (EXISTS "${_gs_qdoc_candidate}")
            set(
                QDOC_EXECUTABLE
                "${_gs_qdoc_candidate}"
                CACHE FILEPATH
                "Path to QDoc executable"
                FORCE
            )
        else()

            find_program(
                _gs_qdoc_found
                NAMES qdoc qdoc.exe
                HINTS
                    "${_gs_qt_root}/bin"
            )

            if (_gs_qdoc_found)
                set(
                    QDOC_EXECUTABLE
                    "${_gs_qdoc_found}"
                    CACHE FILEPATH
                    "Path to QDoc executable"
                    FORCE
                )
            else()
                message(
                    FATAL_ERROR
                    "QDoc executable was not found.\n"
                    "Expected: ${_gs_qdoc_candidate}"
                )
            endif()

        endif()

    endif()

    if (NOT EXISTS "${QDOC_EXECUTABLE}")
        message(
            FATAL_ERROR
            "QDOC_EXECUTABLE does not exist:\n"
            "${QDOC_EXECUTABLE}"
        )
    endif()

    message(
        STATUS
        "GeoScheme QDoc: ${QDOC_EXECUTABLE}"
    )

endfunction()


# ============================================================================
# Определение Qt / MinGW окружения
# ============================================================================

function(_gs_compute_qt_env)

    find_package(Qt5 REQUIRED COMPONENTS Core)

    # ------------------------------------------------------------------------
    # Qt
    # ------------------------------------------------------------------------

    get_filename_component(
        _gs_qt_cmake
        "${Qt5Core_DIR}"
        DIRECTORY
    )

    get_filename_component(
        _gs_qt_lib
        "${_gs_qt_cmake}"
        DIRECTORY
    )

    get_filename_component(
        _gs_qt_root
        "${_gs_qt_lib}"
        DIRECTORY
    )

    get_filename_component(
        _gs_qt_version_root
        "${_gs_qt_root}"
        DIRECTORY
    )

    get_filename_component(
        _gs_qt_sdk_root
        "${_gs_qt_version_root}"
        DIRECTORY
    )

    set(
        _gs_qt_prefix
        "${_gs_qt_root}"
    )

    set(
        _gs_qt_headers
        "${_gs_qt_root}/include"
    )

    set(
        _gs_qt_version
        "${Qt5Core_VERSION}"
    )

    set(
        _gs_qt_docs
        "${_gs_qt_sdk_root}/Docs/Qt-${_gs_qt_version}"
    )


    # ------------------------------------------------------------------------
    # [ИЗМЕНЕНО]
    # Определение MinGW больше не завязано жёстко на:
    #
    #   mingw730_64
    #   x86_64-w64-mingw32
    #   7.3.0
    #
    # Сначала пытаемся найти MinGW рядом с Qt.
    # ------------------------------------------------------------------------

    set(
        _gs_mingw_root
        "${_gs_qt_sdk_root}/Tools/mingw730_64"
    )

    if (NOT IS_DIRECTORY "${_gs_mingw_root}")
        find_program(
            _gs_gcc_program
            NAMES gcc gcc.exe
        )

        if (_gs_gcc_program)
            get_filename_component(
                _gs_mingw_bin
                "${_gs_gcc_program}"
                DIRECTORY
            )

            get_filename_component(
                _gs_mingw_root
                "${_gs_mingw_bin}"
                DIRECTORY
            )
        endif()
    endif()


    if (
        NOT _gs_mingw_root
        OR NOT IS_DIRECTORY "${_gs_mingw_root}"
    )
        message(
            FATAL_ERROR
            "MinGW installation was not found.\n"
            "Qt root: ${_gs_qt_root}"
        )
    endif()


    # ------------------------------------------------------------------------
    # [ДОБАВЛЕНО]
    # Автоматически определяем target architecture и версию GCC.
    # ------------------------------------------------------------------------

    file(
        GLOB
        _gs_mingw_arch_candidates
        LIST_DIRECTORIES true
        "${_gs_mingw_root}/lib/gcc/*"
    )

    set(_gs_mingw_arch_dir "")

    foreach (_gs_candidate IN LISTS _gs_mingw_arch_candidates)

        if (
            IS_DIRECTORY "${_gs_candidate}"
            AND EXISTS "${_gs_candidate}"
        )
            set(
                _gs_mingw_arch_dir
                "${_gs_candidate}"
            )
            break()
        endif()

    endforeach()


    if (NOT _gs_mingw_arch_dir)
        message(
            FATAL_ERROR
            "Cannot determine MinGW target architecture.\n"
            "MinGW root: ${_gs_mingw_root}"
        )
    endif()


    get_filename_component(
        _gs_mingw_target
        "${_gs_mingw_arch_dir}"
        NAME
    )


    file(
        GLOB
        _gs_mingw_version_candidates
        LIST_DIRECTORIES true
        "${_gs_mingw_arch_dir}/*"
    )

    set(_gs_mingw_version_dir "")

    foreach (_gs_candidate IN LISTS _gs_mingw_version_candidates)

        if (
            IS_DIRECTORY "${_gs_candidate}"
            AND IS_DIRECTORY "${_gs_candidate}/include/c++"
        )
            set(
                _gs_mingw_version_dir
                "${_gs_candidate}"
            )
            break()
        endif()

    endforeach()


    if (NOT _gs_mingw_version_dir)
        message(
            FATAL_ERROR
            "Cannot determine MinGW GCC version.\n"
            "Architecture directory: ${_gs_mingw_arch_dir}"
        )
    endif()


    get_filename_component(
        _gs_mingw_version
        "${_gs_mingw_version_dir}"
        NAME
    )


    # ------------------------------------------------------------------------
    # Пути к стандартным заголовкам C++
    # ------------------------------------------------------------------------

    set(
        _gs_mingw_cxx
        "${_gs_mingw_version_dir}/include/c++"
    )

    set(
        _gs_mingw_cxx_target
        "${_gs_mingw_cxx}/${_gs_mingw_target}"
    )

    set(
        _gs_mingw_cxx_backward
        "${_gs_mingw_cxx}/backward"
    )

    set(
        _gs_mingw_include
        "${_gs_mingw_root}/${_gs_mingw_target}/include"
    )


    # ------------------------------------------------------------------------
    # Проверки
    # ------------------------------------------------------------------------

    if (NOT IS_DIRECTORY "${_gs_qt_root}")
        message(
            FATAL_ERROR
            "Qt root directory does not exist:\n"
            "${_gs_qt_root}"
        )
    endif()

    if (NOT IS_DIRECTORY "${_gs_qt_headers}")
        message(
            WARNING
            "Qt headers directory was not found:\n"
            "${_gs_qt_headers}"
        )
    endif()

    if (NOT IS_DIRECTORY "${_gs_qt_docs}")
        message(
            WARNING
            "Qt documentation directory was not found:\n"
            "${_gs_qt_docs}"
        )
    endif()


    # ------------------------------------------------------------------------
    # Глобальные qdocconf
    # ------------------------------------------------------------------------

    set(
        _gs_qt_global_qdocconf
        "${_gs_qt_docs}/global"
    )

    if (NOT IS_DIRECTORY "${_gs_qt_global_qdocconf}")
        message(
            WARNING
            "Qt global QDoc configuration directory was not found:\n"
            "${_gs_qt_global_qdocconf}"
        )
    endif()


    # ------------------------------------------------------------------------
    # Возвращаем значения
    # ------------------------------------------------------------------------

    set(_gs_qt_root "${_gs_qt_root}" PARENT_SCOPE)
    set(_gs_qt_prefix "${_gs_qt_prefix}" PARENT_SCOPE)
    set(_gs_qt_headers "${_gs_qt_headers}" PARENT_SCOPE)
    set(_gs_qt_docs "${_gs_qt_docs}" PARENT_SCOPE)
    set(_gs_qt_version "${_gs_qt_version}" PARENT_SCOPE)

    set(_gs_mingw_root "${_gs_mingw_root}" PARENT_SCOPE)
    set(_gs_mingw_target "${_gs_mingw_target}" PARENT_SCOPE)
    set(_gs_mingw_version "${_gs_mingw_version}" PARENT_SCOPE)

    set(_gs_mingw_cxx "${_gs_mingw_cxx}" PARENT_SCOPE)
    set(_gs_mingw_cxx_target "${_gs_mingw_cxx_target}" PARENT_SCOPE)
    set(_gs_mingw_cxx_backward "${_gs_mingw_cxx_backward}" PARENT_SCOPE)
    set(_gs_mingw_include "${_gs_mingw_include}" PARENT_SCOPE)

endfunction()


# ============================================================================
# Безопасный PATH для QDoc
# ============================================================================

function(_gs_compute_safe_path OUT_PATH)

    if (WIN32)

        # [ИЗМЕНЕНО]
        # Не заменяем PATH целиком.
        # Убираем известный конфликтующий Qt 5.12 и ставим нужные
        # Qt/MinGW в начало.

        set(
            _gs_path
            "$ENV{PATH}"
        )

        string(
            REGEX REPLACE
            "[^;]*Qt5\\.12[^;]*;?"
            ""
            _gs_path
            "${_gs_path}"
        )

        string(
            REGEX REPLACE
            "[^;]*[Mm]ingw730_64[^;]*;?"
            ""
            _gs_path
            "${_gs_path}"
        )

        set(
            _gs_safe_path
            "${_gs_qt_root}/bin;${_gs_mingw_root}/bin;${_gs_path}"
        )

    else()

        # [ДОБАВЛЕНО]
        # Для Unix-подобных систем разделитель PATH другой.

        set(
            _gs_safe_path
            "${_gs_qt_root}/bin:${_gs_mingw_root}/bin:$ENV{PATH}"
        )

    endif()


    set(
        ${OUT_PATH}
        "${_gs_safe_path}"
        PARENT_SCOPE
    )

endfunction()


# ============================================================================
# Сбор include-путей target и его зависимостей
# ============================================================================

function(
    _gs_collect_includes
    TARGET_NAME
    OUT_INCLUDES
    VISITED
)

    # ------------------------------------------------------------------------
    # [ИЗМЕНЕНО]
    # Упрощена сигнатура функции.
    #
    # Раньше был отдельный OUT_TARGETS, который фактически не использовался
    # по назначению и усложнял передачу VISITED.
    # ------------------------------------------------------------------------

    if (NOT TARGET "${TARGET_NAME}")
        set(
            ${OUT_INCLUDES}
            ""
            PARENT_SCOPE
        )
        return()
    endif()


    # Защита от циклических зависимостей.

    if ("${TARGET_NAME}" IN_LIST VISITED)
        set(
            ${OUT_INCLUDES}
            ""
            PARENT_SCOPE
        )
        return()
    endif()


    set(
        _gs_visited_local
        ${VISITED}
        "${TARGET_NAME}"
    )

    set(
        _gs_includes
    )


    # ------------------------------------------------------------------------
    # INCLUDE_DIRECTORIES
    # ------------------------------------------------------------------------

    get_target_property(
        _gs_target_includes
        "${TARGET_NAME}"
        INCLUDE_DIRECTORIES
    )

    if (_gs_target_includes)

        foreach (_gs_include IN LISTS _gs_target_includes)

            if (
                NOT _gs_include STREQUAL ""
                AND NOT _gs_include MATCHES "^\\$<"
            )
                list(
                    APPEND
                    _gs_includes
                    "${_gs_include}"
                )
            endif()

        endforeach()

    endif()


    # ------------------------------------------------------------------------
    # INTERFACE_INCLUDE_DIRECTORIES
    # ------------------------------------------------------------------------

    get_target_property(
        _gs_interface_includes
        "${TARGET_NAME}"
        INTERFACE_INCLUDE_DIRECTORIES
    )

    if (_gs_interface_includes)

        foreach (_gs_include IN LISTS _gs_interface_includes)

            if (
                NOT _gs_include STREQUAL ""
                AND NOT _gs_include MATCHES "^\\$<"
            )
                list(
                    APPEND
                    _gs_includes
                    "${_gs_include}"
                )
            endif()

        endforeach()

    endif()


    # ------------------------------------------------------------------------
    # [ДОБАВЛЕНО]
    # System include directories.
    # ------------------------------------------------------------------------

    get_target_property(
        _gs_system_includes
        "${TARGET_NAME}"
        INTERFACE_SYSTEM_INCLUDE_DIRECTORIES
    )

    if (_gs_system_includes)

        foreach (_gs_include IN LISTS _gs_system_includes)

            if (
                NOT _gs_include STREQUAL ""
                AND NOT _gs_include MATCHES "^\\$<"
            )
                list(
                    APPEND
                    _gs_includes
                    "${_gs_include}"
                )
            endif()

        endforeach()

    endif()


    # ------------------------------------------------------------------------
    # Зависимости target
    # ------------------------------------------------------------------------

    set(_gs_link_libraries)


    get_target_property(
        _gs_link_libraries_local
        "${TARGET_NAME}"
        LINK_LIBRARIES
    )

    if (_gs_link_libraries_local)
        list(
            APPEND
            _gs_link_libraries
            ${_gs_link_libraries_local}
        )
    endif()


    get_target_property(
        _gs_interface_link_libraries
        "${TARGET_NAME}"
        INTERFACE_LINK_LIBRARIES
    )

    if (_gs_interface_link_libraries)
        list(
            APPEND
            _gs_link_libraries
            ${_gs_interface_link_libraries}
        )
    endif()


    # ------------------------------------------------------------------------
    # Рекурсивный обход зависимостей
    # ------------------------------------------------------------------------

    foreach (_gs_lib IN LISTS _gs_link_libraries)

        # debug/optimized/general — специальные ключевые слова CMake.

        if (
            _gs_lib STREQUAL "debug"
            OR _gs_lib STREQUAL "optimized"
            OR _gs_lib STREQUAL "general"
        )
            continue()
        endif()


        # Generator expressions пока не разворачиваем.
        # Они могут зависеть от конфигурации.

        if (_gs_lib MATCHES "^\\$<")
            continue()
        endif()


        if (TARGET "${_gs_lib}")

            _gs_collect_includes(
                "${_gs_lib}"
                _gs_dependency_includes
                "${_gs_visited_local}"
            )

            if (_gs_dependency_includes)
                list(
                    APPEND
                    _gs_includes
                    ${_gs_dependency_includes}
                )
            endif()

        endif()

    endforeach()


    # ------------------------------------------------------------------------
    # AUTOGEN
    # ------------------------------------------------------------------------

    get_target_property(
        _gs_autogen_dir
        "${TARGET_NAME}"
        AUTOGEN_BUILD_DIR
    )

    if (
        _gs_autogen_dir
        AND NOT _gs_autogen_dir MATCHES "-NOTFOUND$"
    )

        # [ИЗМЕНЕНО]
        # Добавляем и сам AUTOGEN_BUILD_DIR, и стандартный include.
        list(
            APPEND
            _gs_includes
            "${_gs_autogen_dir}"
            "${_gs_autogen_dir}/include"
        )

    else()

        get_target_property(
            _gs_target_binary_dir
            "${TARGET_NAME}"
            BINARY_DIR
        )

        if (_gs_target_binary_dir)
            list(
                APPEND
                _gs_includes
                "${_gs_target_binary_dir}/${TARGET_NAME}_autogen"
                "${_gs_target_binary_dir}/${TARGET_NAME}_autogen/include"
            )
        endif()

    endif()


    # ------------------------------------------------------------------------
    # Удаляем дубликаты
    # ------------------------------------------------------------------------

    list(
        REMOVE_DUPLICATES
        _gs_includes
    )


    set(
        ${OUT_INCLUDES}
        ${_gs_includes}
        PARENT_SCOPE
    )

endfunction()


# ============================================================================
# Формирование аргументов -I для QDoc
# ============================================================================

function(
    _gs_build_include_path_args
    TARGET_NAME
    OUT_ARGS
)

    set(_gs_include_paths)


    # ------------------------------------------------------------------------
    # MinGW standard headers
    # ------------------------------------------------------------------------

    foreach (
        _gs_path
        IN ITEMS
            "${_gs_mingw_cxx}"
            "${_gs_mingw_cxx_target}"
            "${_gs_mingw_cxx_backward}"
            "${_gs_mingw_include}"
    )

        if (IS_DIRECTORY "${_gs_path}")
            list(
                APPEND
                _gs_include_paths
                "${_gs_path}"
            )
        endif()

    endforeach()


    # ------------------------------------------------------------------------
    # Qt headers
    # ------------------------------------------------------------------------

    if (IS_DIRECTORY "${_gs_qt_headers}")
        list(
            APPEND
            _gs_include_paths
            "${_gs_qt_headers}"
        )
    endif()


    if (IS_DIRECTORY "${_gs_qt_root}/include/QtCore")
        list(
            APPEND
            _gs_include_paths
            "${_gs_qt_root}/include/QtCore"
        )
    endif()


    # ------------------------------------------------------------------------
    # Target dependencies
    # ------------------------------------------------------------------------

    _gs_collect_includes(
        "${TARGET_NAME}"
        _gs_target_includes
        ""
    )

    if (_gs_target_includes)
        list(
            APPEND
            _gs_include_paths
            ${_gs_target_includes}
        )
    endif()


    # ------------------------------------------------------------------------
    # [ДОБАВЛЕНО]
    # Исходная и бинарная директории target.
    #
    # Это помогает QDoc находить локальные заголовки, которые компилятор
    # находит благодаря текущей директории проекта.
    # ------------------------------------------------------------------------

    get_target_property(
        _gs_source_dir
        "${TARGET_NAME}"
        SOURCE_DIR
    )

    if (_gs_source_dir)
        list(
            APPEND
            _gs_include_paths
            "${_gs_source_dir}"
        )
    endif()


    get_target_property(
        _gs_binary_dir
        "${TARGET_NAME}"
        BINARY_DIR
    )

    if (_gs_binary_dir)
        list(
            APPEND
            _gs_include_paths
            "${_gs_binary_dir}"
        )
    endif()


    # ------------------------------------------------------------------------
    # Фильтрация
    # ------------------------------------------------------------------------

    set(_gs_args)

    foreach (_gs_path IN LISTS _gs_include_paths)

        if (
            NOT _gs_path STREQUAL ""
            AND NOT _gs_path MATCHES "^\\$<"
        )

            list(
                APPEND
                _gs_args
                "-I${_gs_path}"
            )

        endif()

    endforeach()


    list(
        REMOVE_DUPLICATES
        _gs_args
    )


    set(
        ${OUT_ARGS}
        ${_gs_args}
        PARENT_SCOPE
    )

endfunction()


# ============================================================================
# Добавление документации модуля
# ============================================================================

function(
    gs_add_doc_target
    MODULE_NAME
    QDOCCONF_FILENAME
)

    if (NOT GEOSCHEME_BUILD_DOCS)
        return()
    endif()


    # ------------------------------------------------------------------------
    # [ДОБАВЛЕНО]
    # Не допускаем регистрацию одного модуля дважды.
    # ------------------------------------------------------------------------

    get_property(
        _gs_existing_modules
        GLOBAL
        PROPERTY GS_DOC_MODULE_NAMES
    )

    if (
        _gs_existing_modules
        AND "${MODULE_NAME}" IN_LIST _gs_existing_modules
    )

        message(
            WARNING
            "GeoScheme QDoc: module '${MODULE_NAME}' was already registered."
        )

        return()

    endif()


    set(
        _gs_mod_conf
        "${CMAKE_CURRENT_SOURCE_DIR}/${QDOCCONF_FILENAME}"
    )


    if (NOT EXISTS "${_gs_mod_conf}")
        message(
            FATAL_ERROR
            "QDoc configuration file for module '${MODULE_NAME}' "
            "was not found:\n${_gs_mod_conf}"
        )
    endif()


    if (NOT TARGET "${MODULE_NAME}")
        message(
            FATAL_ERROR
            "GeoScheme QDoc: target '${MODULE_NAME}' does not exist."
        )
    endif()


    # ------------------------------------------------------------------------
    # [ИЗМЕНЕНО]
    #
    # Раньше здесь сразу создавался custom command и include-пути вычислялись
    # в момент вызова функции.
    #
    # Теперь мы только регистрируем модуль.
    #
    # Реальная команда QDoc создаётся в gs_finalize_doc_index(), когда уже
    # полностью сформирован target graph всего проекта.
    #
    # Это позволяет увидеть зависимости, которые объявляются позже
    # в других CMakeLists.txt.
    # ------------------------------------------------------------------------

    set(
        _gs_record
        "${MODULE_NAME}|${_gs_mod_conf}|${CMAKE_CURRENT_SOURCE_DIR}"
    )


    set_property(
        GLOBAL
        APPEND
        PROPERTY GS_DOC_MODULE_RECORDS
        "${_gs_record}"
    )

    set_property(
        GLOBAL
        APPEND
        PROPERTY GS_DOC_MODULE_NAMES
        "${MODULE_NAME}"
    )


    message(
        STATUS
        "GeoScheme QDoc: registered module '${MODULE_NAME}'"
    )

endfunction()


# ============================================================================
# Финализация документации и создание общего индекса
# ============================================================================

function(gs_finalize_doc_index)

    if (NOT GEOSCHEME_BUILD_DOCS)
        return()
    endif()


    # ------------------------------------------------------------------------
    # [ДОБАВЛЕНО]
    # Защита от повторного вызова finalize.
    # ------------------------------------------------------------------------

    get_property(
        _gs_finalized
        GLOBAL
        PROPERTY GS_DOC_FINALIZED
    )

    if (_gs_finalized)
        message(
            WARNING
            "GeoScheme QDoc: gs_finalize_doc_index() was already called."
        )
        return()
    endif()


    set_property(
        GLOBAL
        PROPERTY GS_DOC_FINALIZED
        TRUE
    )


    # ------------------------------------------------------------------------
    # Поиск QDoc и окружения
    # ------------------------------------------------------------------------

    _gs_find_qdoc()
    _gs_compute_qt_env()
    _gs_compute_safe_path(
        _gs_safe_path
    )


    # ------------------------------------------------------------------------
    # Пути проекта
    # ------------------------------------------------------------------------

    get_filename_component(
        _gs_project_root
        "${CMAKE_SOURCE_DIR}"
        DIRECTORY
    )

    set(
        _gs_html_root
        "${_gs_project_root}/doc/qdoc/html"
    )


    # ------------------------------------------------------------------------
    # [ИЗМЕНЕНО]
    # Получаем зарегистрированные модули.
    # ------------------------------------------------------------------------

    get_property(
        _gs_module_records
        GLOBAL
        PROPERTY GS_DOC_MODULE_RECORDS
    )


    get_property(
        _gs_module_names
        GLOBAL
        PROPERTY GS_DOC_MODULE_NAMES
    )


    set(
        _gs_module_targets
    )

    set(
        _gs_module_stamps
    )


    # =========================================================================
    # Документация отдельных модулей
    # =========================================================================

    foreach (_gs_record IN LISTS _gs_module_records)

        # Разбираем:
        #
        #   MODULE_NAME|QDOCCONF|SOURCE_DIR

        string(
            REPLACE
            "|"
            ";"
            _gs_parts
            "${_gs_record}"
        )

        list(
            GET
            _gs_parts
            0
            _gs_module_name
        )

        list(
            GET
            _gs_parts
            1
            _gs_mod_conf
        )

        list(
            GET
            _gs_parts
            2
            _gs_source_dir
        )


        set(
            _gs_out_dir
            "${_gs_html_root}/${_gs_module_name}"
        )

        set(
            _gs_stamp
            "${_gs_out_dir}/.cmake_docs_stamp"
        )

        set(
            _gs_doc_target
            "docs_${_gs_module_name}"
        )


        # ---------------------------------------------------------------------
        # [ДОБАВЛЕНО]
        # Include paths вычисляются здесь, после формирования всего
        # target graph проекта.
        # ---------------------------------------------------------------------

        _gs_build_include_path_args(
            "${_gs_module_name}"
            _gs_include_path_args
        )


        # ---------------------------------------------------------------------
        # Custom command
        # ---------------------------------------------------------------------

        # [ИЗМЕНЕНО]
        #
        # Больше НЕТ:
        #
        #   if (IS_DIRECTORY "${_gs_out_dir}")
        #       add_custom_target(...)
        #   endif()
        #
        # Директория HTML теперь не является признаком успешной сборки.
        #
        # Единственный cache marker — stamp-файл.
        #
        # Поэтому после удаления HTML custom command всегда остаётся
        # зарегистрированным и корректно выполняется снова.

        add_custom_command(
            OUTPUT
                "${_gs_stamp}"

            COMMAND
                "${CMAKE_COMMAND}"
                -E
                make_directory
                "${_gs_out_dir}"

            COMMAND
                "${CMAKE_COMMAND}"
                -E
                env
                "PATH=${_gs_safe_path}"
                "QT_INSTALL_PREFIX=${_gs_qt_prefix}"
                "QT_INSTALL_DOCS=${_gs_qt_docs}"
                "INCLUDE="
                "CPLUS_INCLUDE_PATH="
                "C_INCLUDE_PATH="
                "${QDOC_EXECUTABLE}"
                --no-link-errors
                "-std=c++${GEOSCHEME_QDOC_CXX_STANDARD}"
                ${_gs_include_path_args}
                "${_gs_mod_conf}"

            COMMAND
                "${CMAKE_COMMAND}"
                -E
                touch
                "${_gs_stamp}"

            DEPENDS
                "${_gs_mod_conf}"

            COMMENT
                "Generating QDoc documentation: ${_gs_module_name}"

            VERBATIM
        )


        add_custom_target(
            "${_gs_doc_target}"
            DEPENDS
                "${_gs_stamp}"
        )


        # ---------------------------------------------------------------------
        # Документация строится после самого модуля.
        # ---------------------------------------------------------------------

        add_dependencies(
            "${_gs_doc_target}"
            "${_gs_module_name}"
        )


        # ---------------------------------------------------------------------
        # Rebuild конкретного модуля
        # ---------------------------------------------------------------------

        # [ИЗМЕНЕНО]
        #
        # Удаляем stamp вместе со всей директорией.
        # После этого обычный target docs_<module> увидит отсутствующий OUTPUT
        # и заново запустит QDoc.

        set(
            _gs_rebuild_target
            "docs_${_gs_module_name}_rebuild"
        )


        add_custom_target(
            "${_gs_rebuild_target}"

            COMMAND
                "${CMAKE_COMMAND}"
                -E
                remove_directory
                "${_gs_out_dir}"

            COMMAND
                "${CMAKE_COMMAND}"
                --build
                "${CMAKE_BINARY_DIR}"
                --target
                "${_gs_doc_target}"

            COMMENT
                "Rebuilding QDoc documentation: ${_gs_module_name}"
        )


        list(
            APPEND
            _gs_module_targets
            "${_gs_doc_target}"
        )

        list(
            APPEND
            _gs_module_stamps
            "${_gs_stamp}"
        )


    endforeach()


    # =========================================================================
    # Общий индекс GeoScheme
    # =========================================================================

    set(
        _gs_main_conf
        "${_gs_project_root}/doc/qdoc/main-index/GeoScheme.qdocconf"
    )


    if (NOT EXISTS "${_gs_main_conf}")

        message(
            FATAL_ERROR
            "GeoScheme QDoc main configuration was not found:\n"
            "${_gs_main_conf}"
        )

    endif()


    set(
        _gs_index_out_dir
        "${_gs_html_root}/GeoScheme"
    )

    set(
        _gs_index_stamp
        "${_gs_index_out_dir}/.cmake_docs_stamp"
    )


    # ------------------------------------------------------------------------
    # [ИЗМЕНЕНО]
    # Общий индекс теперь получает include-пути всех зарегистрированных
    # модулей, а не только MinGW + Qt.
    # ------------------------------------------------------------------------

    set(
        _gs_index_include_paths
    )


    # Базовые MinGW include.

    foreach (
        _gs_path
        IN ITEMS
            "${_gs_mingw_cxx}"
            "${_gs_mingw_cxx_target}"
            "${_gs_mingw_cxx_backward}"
            "${_gs_mingw_include}"
    )

        if (IS_DIRECTORY "${_gs_path}")
            list(
                APPEND
                _gs_index_include_paths
                "${_gs_path}"
            )
        endif()

    endforeach()


    # Qt.

    if (IS_DIRECTORY "${_gs_qt_headers}")
        list(
            APPEND
            _gs_index_include_paths
            "${_gs_qt_headers}"
        )
    endif()


    if (IS_DIRECTORY "${_gs_qt_root}/include/QtCore")
        list(
            APPEND
            _gs_index_include_paths
            "${_gs_qt_root}/include/QtCore"
        )
    endif()


    # Include paths всех модулей.

    foreach (_gs_module_name IN LISTS _gs_module_names)

        if (TARGET "${_gs_module_name}")

            _gs_collect_includes(
                "${_gs_module_name}"
                _gs_index_target_includes
                ""
            )

            if (_gs_index_target_includes)
                list(
                    APPEND
                    _gs_index_include_paths
                    ${_gs_index_target_includes}
                )
            endif()


            get_target_property(
                _gs_module_source_dir
                "${_gs_module_name}"
                SOURCE_DIR
            )

            if (_gs_module_source_dir)
                list(
                    APPEND
                    _gs_index_include_paths
                    "${_gs_module_source_dir}"
                )
            endif()


            get_target_property(
                _gs_module_binary_dir
                "${_gs_module_name}"
                BINARY_DIR
            )

            if (_gs_module_binary_dir)
                list(
                    APPEND
                    _gs_index_include_paths
                    "${_gs_module_binary_dir}"
                )
            endif()

        endif()

    endforeach()


    list(
        REMOVE_DUPLICATES
        _gs_index_include_paths
    )


    set(
        _gs_index_include_args
    )

    foreach (
        _gs_path
        IN LISTS
        _gs_index_include_paths
    )

        if (
            NOT _gs_path STREQUAL ""
            AND NOT _gs_path MATCHES "^\\$<"
        )

            list(
                APPEND
                _gs_index_include_args
                "-I${_gs_path}"
            )

        endif()

    endforeach()


    list(
        REMOVE_DUPLICATES
        _gs_index_include_args
    )


    # ------------------------------------------------------------------------
    # Custom command общего индекса
    # ------------------------------------------------------------------------

    # [ИЗМЕНЕНО]
    # Здесь используется та же stamp-модель, что и для модулей.

    add_custom_command(
        OUTPUT
            "${_gs_index_stamp}"

        COMMAND
            "${CMAKE_COMMAND}"
            -E
            make_directory
            "${_gs_index_out_dir}"

        COMMAND
            "${CMAKE_COMMAND}"
            -E
            env
            "PATH=${_gs_safe_path}"
            "QT_INSTALL_PREFIX=${_gs_qt_prefix}"
            "QT_INSTALL_DOCS=${_gs_qt_docs}"
            "INCLUDE="
            "CPLUS_INCLUDE_PATH="
            "C_INCLUDE_PATH="
            "${QDOC_EXECUTABLE}"
            --no-link-errors
            "-std=c++${GEOSCHEME_QDOC_CXX_STANDARD}"
            ${_gs_index_include_args}
            "${_gs_main_conf}"

        COMMAND
            "${CMAKE_COMMAND}"
            -E
            touch
            "${_gs_index_stamp}"

        DEPENDS
            "${_gs_main_conf}"
            ${_gs_module_stamps}

        COMMENT
            "Generating GeoScheme QDoc index"

        VERBATIM
    )


    add_custom_target(
        docs_GeoScheme_index
        DEPENDS
            "${_gs_index_stamp}"
    )


    # ------------------------------------------------------------------------
    # Индекс строится после документации всех модулей.
    # ------------------------------------------------------------------------

    if (_gs_module_targets)

        add_dependencies(
            docs_GeoScheme_index
            ${_gs_module_targets}
        )

    endif()


    # =========================================================================
    # Полная пересборка
    # =========================================================================

    # [ИЗМЕНЕНО]
    #
    # Удаляем весь html root.
    # Все stamp-файлы исчезают, поэтому при следующем build QDoc
    # автоматически запускается для всех модулей.

    add_custom_target(
        docs_rebuild_all

        COMMAND
            "${CMAKE_COMMAND}"
            -E
            remove_directory
            "${_gs_html_root}"

        COMMAND
            "${CMAKE_COMMAND}"
            --build
            "${CMAKE_BINARY_DIR}"
            --target
            docs_GeoScheme_index

        COMMENT
            "Rebuilding all GeoScheme QDoc documentation"
    )


    # =========================================================================
    # Информация
    # =========================================================================

    message(
        STATUS
        "------------------------------------------------------------"
    )

    message(
        STATUS
        "GeoScheme QDoc configuration"
    )

    message(
        STATUS
        "  QDoc:           ${QDOC_EXECUTABLE}"
    )

    message(
        STATUS
        "  Qt root:        ${_gs_qt_root}"
    )

    message(
        STATUS
        "  Qt version:     ${_gs_qt_version}"
    )

    message(
        STATUS
        "  Qt docs:        ${_gs_qt_docs}"
    )

    message(
        STATUS
        "  MinGW root:     ${_gs_mingw_root}"
    )

    message(
        STATUS
        "  MinGW target:   ${_gs_mingw_target}"
    )

    message(
        STATUS
        "  MinGW version:  ${_gs_mingw_version}"
    )

    message(
        STATUS
        "  C++ standard:   ${GEOSCHEME_QDOC_CXX_STANDARD}"
    )

    message(
        STATUS
        "  HTML root:      ${_gs_html_root}"
    )

    message(
        STATUS
        "  Modules:        ${_gs_module_names}"
    )

    message(
        STATUS
        "------------------------------------------------------------"
    )

endfunction()
Что именно я исправил
1. Самое важное — убрана проверка IS_DIRECTORY при создании QDoc-команд.
У тебя было примерно:
if (IS_DIRECTORY "${_gs_out_dir}")
    add_custom_target(...)
else()
    add_custom_command(...)
endif()
Это была главная проблема. Если папка html/GeoProjectData уже существует, CMake мог вообще не зарегистрировать custom_command. После этого docs_GeoProjectData_rebuild фактически мог остаться без команды, способной заново создать документацию.
Теперь custom command регистрируется всегда, а признаком готовности служит:
.cmake_docs_stamp


⸻


2. rebuild теперь действительно может пересобрать документацию.
Удаляется:
doc/qdoc/html/GeoProjectData
а затем запускается:
docs_GeoProjectData
Поскольку .cmake_docs_stamp удалён вместе с директорией, CMake видит отсутствующий OUTPUT и снова запускает QDoc.


⸻


3. docs_rebuild_all исправлен по той же схеме.
Теперь:
docs_rebuild_all
        ↓
удаляет весь html
        ↓
docs_GeoScheme_index
        ↓
документация модулей
        ↓
общий индекс


⸻


4. Убрал LOCATION у Qt5::Core.
Вместо:
get_target_property(... Qt5::Core LOCATION)
используется Qt5Core_DIR.
Это значительно аккуратнее для CMake/Qt 5.


⸻


5. Убрал жёсткую привязку к 7.3.0.
Раньше пути были непосредственно:
mingw730_64
x86_64-w64-mingw32
7.3.0
Теперь версия GCC и target architecture определяются из установленного MinGW.
При этом твой текущий Qt 5.14.2 + MinGW 7.3 должен определиться как раньше.


⸻


6. Исправил сбор include-путей.
Теперь учитываются:
	•	INCLUDE_DIRECTORIES;
	•	INTERFACE_INCLUDE_DIRECTORIES;
	•	INTERFACE_SYSTEM_INCLUDE_DIRECTORIES;
	•	LINK_LIBRARIES;
	•	INTERFACE_LINK_LIBRARIES;
	•	зависимости зависимостей;
	•	AUTOGEN_BUILD_DIR;
	•	autogen/include;
	•	SOURCE_DIR;
	•	BINARY_DIR;
	•	MinGW C++ headers;
	•	Qt headers.
И есть защита от циклических зависимостей.


⸻


7. Главное изменение архитектуры — include-пути модулей вычисляются в gs_finalize_doc_index().
То есть сначала CMake успевает построить весь target graph:
GeoProjectData
    ↓
какие библиотеки подключены
    ↓
какие у них include directories
    ↓
какие у них зависимости
и только потом создаётся команда QDoc.
Это должно убрать часть проблем, когда библиотека подключалась к target уже после вызова gs_add_doc_target().


⸻


8. Общий GeoScheme.qdocconf теперь тоже получает include-пути модулей.
Раньше общий индекс получал в основном:
Qt
MinGW
Теперь он дополнительно получает include-пути всех зарегистрированных модулей.


⸻


9. Добавил проверку отсутствующих .qdocconf.
Если написать:
gs_add_doc_target(GeoProjectData GeoProjectData.qdocconf)
а файла нет, CMake сразу остановится с понятной ошибкой, а не выдаст загадочную ошибку уже при запуске QDoc.


⸻


10. Добавил защиту от повторной регистрации.
Если один модуль случайно зарегистрировать два раза:
gs_add_doc_target(GeoProjectData ...)
gs_add_doc_target(GeoProjectData ...)
второй раз он не создаст дубликаты целей.


⸻


Как теперь использовать
В корневом CMakeLists.txt:
include(GeoSchemeDocs.cmake)

add_subdirectory(...)
add_subdirectory(...)
add_subdirectory(...)

if (GEOSCHEME_BUILD_DOCS)
    gs_finalize_doc_index()
endif()
А в CMakeLists.txt конкретного модуля:
if (GEOSCHEME_BUILD_DOCS)
    gs_add_doc_target(
        GeoProjectData
        GeoProjectData.qdocconf
    )
endif()
После этого:
mingw32-make docs_GeoProjectData
— собрать документацию одного модуля.
mingw32-make docs_GeoProjectData_rebuild
— принудительно пересобрать его.
mingw32-make docs_GeoScheme_index
— собрать документацию + общий индекс.
mingw32-make docs_rebuild_all
— полностью снести HTML и пересобрать всё.
Важный момент: я специально оставил -std=c++14 по умолчанию, потому что у тебя именно этот стандарт использовался в текущем варианте. Теперь его можно поменять одной переменной, не переписывая CMake-файл.
